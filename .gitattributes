# Vendor documentation mirrors are byte-exact, hash-pinned snapshots (each has a
# MANIFEST.json of sha256 per page). `-text` stops core.autocrlf from rewriting their line
# endings on commit or checkout, which would break every hash without touching the content.
vobiz-findings/mirror/** -text
thinnest-findings/mirror/** -text
bolna-findings/mirror/** -text

# Shell scripts and the privileged host helpers run on Linux; a CRLF checkout (Git for
# Windows defaults to core.autocrlf=true) makes bash fail on `$'\r'` before the first line.
*.sh text eol=lf
infra/privileged/sbin/* text eol=lf
