# Calevate site config — the four server names of DEPLOYMENT §5.1.
#
#   admin.${ROOT_DOMAIN}  ┐
#   app.${ROOT_DOMAIN}    ┴─▶ 127.0.0.1:3000   web (Next.js under pm2, on the host)
#   api.${ROOT_DOMAIN}    ──▶ 127.0.0.1:8000   api container
#   hooks.${ROOT_DOMAIN}  ──▶ 127.0.0.1:8100   voice-runtime container  ← never gated
#
# Rendered by `scripts/vps-deploy.sh` with `envsubst` over an EXPLICIT variable list, so
# an unrelated `$` in this file (every nginx variable is one) survives the render. That
# list is five names — one `envsubst` invocation renders all three templates — and the
# three THIS file uses are:
#
#   ROOT_DOMAIN  ACME_WEBROOT  TLS_LIVE_DIR
#
# (`ORIGIN_CERT_PATH` and `ORIGIN_KEY_PATH` are the other two and belong to
# `000-default.conf.template`. Stated as five-of-which-three rather than as three,
# because a reader who adds a variable here needs the render's list, not this file's.)
#
# NO SECRET IS SUBSTITUTED HERE and none ever should be: nginx config is world-readable
# on most hosts, and TLS private keys are referenced by path, never inlined.
#
# WHAT IS DELIBERATELY NOT IN THIS FILE (see infra/nginx/README.md §3): the maintenance
# gate and its `error_page 401 =503` machinery, and `auth_request`. Both are real parts
# of DEPLOYMENT §5's inheritance and both are load-bearing enough that a half-remembered
# version is worse than none — they are named as not-built rather than approximated.

upstream calevate_web   { server 127.0.0.1:3000; keepalive 16; }
upstream calevate_api   { server 127.0.0.1:8000; keepalive 16; }
upstream calevate_hooks { server 127.0.0.1:8100; keepalive 32; }

# --- shared proxy behaviour -----------------------------------------------------
# Not a `snippets/` include: this file is rendered as one unit and an include that is
# installed separately is one more thing that can be a version behind the config that
# depends on it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- port 80: ACME, then away ---------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name admin.${ROOT_DOMAIN} app.${ROOT_DOMAIN} api.${ROOT_DOMAIN} hooks.${ROOT_DOMAIN};

    # certbot renews over HTTP-01 through this path. It must be served BEFORE the
    # redirect, and it must not be behind the Cloudflare origin lock — Let's Encrypt
    # validates from its own addresses, and with the zone proxied the request arrives
    # through Cloudflare anyway. Keeping it above the 301 is the whole trick; a config
    # that redirects the challenge is a renewal that fails 60 days later, quietly.
    location ^~ /.well-known/acme-challenge/ {
        root ${ACME_WEBROOT};
        default_type "text/plain";
    }

    # Cloudflare must be set to Full (STRICT). With Flexible, Cloudflare speaks HTTP to
    # this server, gets this 301 back, and loops (DEPLOYMENT §5).
    location / { return 301 https://$host$request_uri; }
}

# --- admin + app: the two browser realms, and they are now actually two -----------
#
# THIS WAS ONE SERVER BLOCK FOR BOTH HOSTNAMES (P7.3), which made a premise the frontend
# reasons from simply untrue: disjoint route trees on disjoint hostnames, so only one
# realm's session provider is ever mounted. With one block and one `location /`,
# `app.${ROOT_DOMAIN}/admin` served the operator console and
# `admin.${ROOT_DOMAIN}/c/<slug>` served a client dashboard.
#
# WHAT IT WAS AND WAS NOT. Not an authorization hole: the realm is inside the session
# token's hash domain (`authn/sessions.token_fingerprint`), so a client credential
# presented on the admin door matches no row whatever hostname carried it. What it WAS is
# the operator SIGN-IN surface — `/auth/admin/sign-in` — served on the hostname every
# client is told to visit, which is phishing surface for the one console that holds
# cross-client data. A 404 costs nothing and removes it.
#
# IT MATTERS MORE SINCE D-177, and AUTH-MIGRATION §3 called that in advance: both realms'
# `__Host-` cookies land on one API host, so the hostname split is what keeps the two
# consoles apart in a browser rather than merely tidy.
#
# `^~` RATHER THAN A PREFIX MATCH, and the marker is the load-bearing part: nginx tries
# regex locations before plain prefix ones, so a future `location ~ \.(js|css)$` added
# above would win over `location /admin` and re-open the hole. `^~` stops the search at the
# longest matching prefix and cannot be overtaken by a regex added later.
#
# 404 RATHER THAN 403, deliberately: 403 confirms that something is there. A stranger
# probing `app.${ROOT_DOMAIN}/admin` learns nothing they did not already know.
#
# The two blocks are otherwise IDENTICAL, and the duplication is the point rather than a
# smell — they proxy the same upstream and differ only in which realm each refuses. An
# include would make the difference the only thing NOT in the file a reviewer reads.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.${ROOT_DOMAIN};

    ssl_certificate     ${TLS_LIVE_DIR}/fullchain.pem;
    ssl_certificate_key ${TLS_LIVE_DIR}/privkey.pem;
    include /etc/nginx/snippets/calevate-tls.conf;
    include /etc/nginx/snippets/calevate-origin.conf;
    include /etc/nginx/snippets/calevate-headers.conf;

    # Timeouts at SERVER scope, because `calevate-proxy.conf` deliberately sets none —
    # an include is textual, so a timeout in that file would land at location scope in
    # every block below and shadow this. `tests/assist_deadline_test.py` reads the api
    # vhost's `proxy_read_timeout` as the budget the dashboard-assist path must fit
    # inside, so 60s here is a Python deadline as well as an nginx one.
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    # Next.js serves its own static assets; 25m covers a KB document upload from the
    # dashboard without letting the edge become an upload sink.
    client_max_body_size 25m;

    # The ADMIN realm does not exist on the client hostname. Covers `/admin/sign-in` —
    # the operator door — and every operator screen under it.
    location ^~ /admin { return 404; }

    location / {
        limit_req zone=default burst=30 nodelay;
        proxy_pass http://calevate_web;
        include /etc/nginx/snippets/calevate-proxy.conf;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name admin.${ROOT_DOMAIN};

    ssl_certificate     ${TLS_LIVE_DIR}/fullchain.pem;
    ssl_certificate_key ${TLS_LIVE_DIR}/privkey.pem;
    include /etc/nginx/snippets/calevate-tls.conf;
    include /etc/nginx/snippets/calevate-origin.conf;
    include /etc/nginx/snippets/calevate-headers.conf;

    # Timeouts at SERVER scope, because `calevate-proxy.conf` deliberately sets none —
    # an include is textual, so a timeout in that file would land at location scope in
    # every block below and shadow this. `tests/assist_deadline_test.py` reads the api
    # vhost's `proxy_read_timeout` as the budget the dashboard-assist path must fit
    # inside, so 60s here is a Python deadline as well as an nginx one.
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    client_max_body_size 25m;

    # The CLIENT realm does not exist on the operator hostname. `/c/` is the client
    # dashboard's whole tree (`apps/web/src/app/c/<slug>/...`). An operator who needs to
    # see a client's screens uses impersonation (D-22), which is audited; a URL that
    # serves them silently on this host is the thing that makes that audit optional.
    location ^~ /c/ { return 404; }

    location / {
        limit_req zone=default burst=30 nodelay;
        proxy_pass http://calevate_web;
        include /etc/nginx/snippets/calevate-proxy.conf;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# --- api: both realms' backend --------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.${ROOT_DOMAIN};

    ssl_certificate     ${TLS_LIVE_DIR}/fullchain.pem;
    ssl_certificate_key ${TLS_LIVE_DIR}/privkey.pem;
    include /etc/nginx/snippets/calevate-tls.conf;
    include /etc/nginx/snippets/calevate-origin.conf;
    include /etc/nginx/snippets/calevate-headers.conf;

    # Timeouts at SERVER scope, because `calevate-proxy.conf` deliberately sets none —
    # an include is textual, so a timeout in that file would land at location scope in
    # every block below and shadow this. `tests/assist_deadline_test.py` reads the api
    # vhost's `proxy_read_timeout` as the budget the dashboard-assist path must fit
    # inside, so 60s here is a Python deadline as well as an nginx one.
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    client_max_body_size 25m;

    # Ordered most-specific first. nginx picks the longest matching prefix, so the order
    # here is for the reader; the `=` and `^~` markers are what actually pin them.
    #
    # THESE STAY OPEN, AND THE RESTRICTION THAT BELONGS HERE IS NOT AN `allow`/`deny`
    # (D-128). `/healthz/ready` used to publish the NAMES of the credentials this
    # deployment had not installed. It is fixed in the app — the status word and the
    # status code answer everybody, the detail answers `ops:manage` — because the
    # alternative considered here does not work: `calevate-origin.conf` is included by
    # this server block already, and what it admits is every Cloudflare edge range, i.e.
    # the whole internet on a proxied zone. A tighter `allow` list here would refuse the
    # authorised operator alongside the stranger, since both arrive from the same edge.
    location = /healthz          { limit_req zone=health burst=5 nodelay; proxy_pass http://calevate_api; include /etc/nginx/snippets/calevate-proxy.conf; }
    location ^~ /healthz/        { limit_req zone=health burst=5 nodelay; proxy_pass http://calevate_api; include /etc/nginx/snippets/calevate-proxy.conf; }

    # Sessions and token exchange. The tightest zone in the set.
    location ^~ /v1/auth/ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://calevate_api;
        include /etc/nginx/snippets/calevate-proxy.conf;
    }

    location ^~ /v1/admin/ {
        limit_req zone=admin_api burst=40 nodelay;
        proxy_pass http://calevate_api;
        include /etc/nginx/snippets/calevate-proxy.conf;
    }

    location / {
        limit_req zone=client_api burst=30 nodelay;
        proxy_pass http://calevate_api;
        include /etc/nginx/snippets/calevate-proxy.conf;
    }
}

# --- hooks: voice-runtime's public face -----------------------------------------
# POLICY, restated here because it is the one server block whose rules are inverted
# (DEPLOYMENT §5.2): NEVER maintenance-gated, NEVER behind auth_request, NEVER challenged
# at the edge. An engine callback that meets a maintenance page or a bot challenge is a
# lost call, and Bolna sends no retry (D-31) — the reconciliation poller is the only
# recovery and it runs on a 10-minute tick.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name hooks.${ROOT_DOMAIN};

    ssl_certificate     ${TLS_LIVE_DIR}/fullchain.pem;
    ssl_certificate_key ${TLS_LIVE_DIR}/privkey.pem;
    include /etc/nginx/snippets/calevate-tls.conf;
    include /etc/nginx/snippets/calevate-origin.conf;
    include /etc/nginx/snippets/calevate-headers.conf;

    # Sized for a post-call payload carrying a full transcript. Larger than the browser
    # realms because the sender is a machine we cannot ask to paginate.
    client_max_body_size 10m;

    # Do not let a slow upstream turn into a queue of held connections on the box that
    # also has to ack in 500ms. The app abandons at its own 2s durable deadline and
    # answers 503; these bounds are the layer above that, not a replacement for it.
    #
    # THESE ARE THE EFFECTIVE VALUES for every location in this vhost, and the note that
    # stood here saying they "govern nothing today" described a config that nginx refuses
    # to load. `calevate-proxy.conf` set the browser realms' 5s/60s/60s and the catch-all
    # below restated 2s/15s/15s after including it — two `proxy_connect_timeout` at one
    # level, which is `[emerg] directive is duplicate`, not a last-one-wins. The snippet
    # no longer sets any timeout, so nothing shadows these and there is nothing to keep
    # in step.
    proxy_connect_timeout 2s;
    proxy_send_timeout    15s;
    proxy_read_timeout    15s;

    # NO HEALTH ROUTE ON THIS HOSTNAME, and a 404 rather than a deletion.
    #
    # This vhost used to proxy `= /healthz` and `^~ /healthz/` to voice-runtime. Nothing
    # needs them here: the deploy polls `127.0.0.1:8100/healthz` directly and compose's
    # healthcheck runs `/healthz/live` inside the container, so both readers are already
    # on the loopback side of nginx. What the pair DID buy was a public path to
    # `/healthz/ready`, whose handler resolves the engine adapter and drags `httpx` and
    # `apps.api.engine.bolna` onto the event loop that has 500ms to ack a webhook —
    # measured at 381-435ms of import on a first call, on the one service where that is a
    # lost call rather than a slow page.
    #
    # DELETING the two lines does NOT close it: `location /` below is a prefix match on
    # `/`, so every `/healthz*` request would simply fall through to it and reach the same
    # handler — with the webhook rate zone paying for it. Closing it takes a location that
    # answers instead of proxying, and `^~` so it wins over that catch-all.
    #
    # 404, not 403: the route genuinely does not exist on `hooks.`, and saying so tells a
    # scanner less than a refusal does. The app-side fix (a per-service config probe, so
    # readiness never constructs an adapter) is the other half and is not made redundant
    # by this — voice-runtime still serves the route on the loopback interface.
    location ^~ /healthz { return 404; }

    location / {
        # `burst=200 nodelay` on top of 600r/m: the average is a campaign's worth of
        # traffic, the burst is 250 calls hanging up in the same second (D-32). Without
        # the burst allowance the steady-state rate alone would reject the exact shape of
        # traffic this endpoint exists for.
        limit_req zone=webhooks burst=200 nodelay;
        proxy_pass http://calevate_hooks;
        include /etc/nginx/snippets/calevate-proxy.conf;

        # `auth_request` buffers the request body, which breaks large POSTs
        # (DEPLOYMENT §10). There is no auth_request here, and streaming the body to the
        # app rather than buffering it at the edge is also how the ack budget is measured
        # from the first byte the app sees.
        proxy_request_buffering off;
    }
}
