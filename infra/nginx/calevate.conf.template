# Calevate site config — the four server names of DEPLOYMENT §5.1.
#
#   admin.${ROOT_DOMAIN}  ┐
#   app.${ROOT_DOMAIN}    ┴─▶ 127.0.0.1:3000   web (Next.js under pm2, on the host)
#   api.${ROOT_DOMAIN}    ──▶ 127.0.0.1:8000   api container
#   hooks.${ROOT_DOMAIN}  ──▶ 127.0.0.1:8100   voice-runtime container  ← never gated
#
# Rendered by `scripts/vps-deploy.sh` with `envsubst` over an EXPLICIT variable list, so
# an unrelated `$` in this file (every nginx variable is one) survives the render. That
# list is five names — one `envsubst` invocation renders all three templates — and the
# three THIS file uses are:
#
#   ROOT_DOMAIN  ACME_WEBROOT  TLS_LIVE_DIR
#
# (`ORIGIN_CERT_PATH` and `ORIGIN_KEY_PATH` are the other two and belong to
# `000-default.conf.template`. Stated as five-of-which-three rather than as three,
# because a reader who adds a variable here needs the render's list, not this file's.)
#
# NO SECRET IS SUBSTITUTED HERE and none ever should be: nginx config is world-readable
# on most hosts, and TLS private keys are referenced by path, never inlined.
#
# WHAT IS DELIBERATELY NOT IN THIS FILE (see infra/nginx/README.md §3): the maintenance
# gate and its `error_page 401 =503` machinery, and `auth_request`. Both are real parts
# of DEPLOYMENT §5's inheritance and both are load-bearing enough that a half-remembered
# version is worse than none — they are named as not-built rather than approximated.

upstream calevate_web   { server 127.0.0.1:3000; keepalive 16; }
upstream calevate_api   { server 127.0.0.1:8000; keepalive 16; }
upstream calevate_hooks { server 127.0.0.1:8100; keepalive 32; }

# --- shared proxy behaviour -----------------------------------------------------
# Not a `snippets/` include: this file is rendered as one unit and an include that is
# installed separately is one more thing that can be a version behind the config that
# depends on it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# --- port 80: ACME, then away ---------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${ROOT_DOMAIN} www.${ROOT_DOMAIN}
                admin.${ROOT_DOMAIN} app.${ROOT_DOMAIN} api.${ROOT_DOMAIN} hooks.${ROOT_DOMAIN};

    # certbot renews over HTTP-01 through this path. It must be served BEFORE the
    # redirect, and it must not be behind the Cloudflare origin lock — Let's Encrypt
    # validates from its own addresses, and with the zone proxied the request arrives
    # through Cloudflare anyway. Keeping it above the 301 is the whole trick; a config
    # that redirects the challenge is a renewal that fails 60 days later, quietly.
    location ^~ /.well-known/acme-challenge/ {
        root ${ACME_WEBROOT};
        default_type "text/plain";
    }

    # Cloudflare must be set to Full (STRICT). With Flexible, Cloudflare speaks HTTP to
    # this server, gets this 301 back, and loops (DEPLOYMENT §5).
    location / { return 301 https://$host$request_uri; }
}

# --- the apex and www: the public marketing site -----------------------------------
#
# WHY THIS BLOCK EXISTS AT ALL. It did not, and `calevate.tech` was a live defect: the
# marketing page IS `apps/web/src/app/page.tsx` and Next serves it at `/`, but no server
# block named the apex — so the zone's apex record pointed at this host and landed on
# `000-default`, which answers `return 444`. The public front door of the product closed
# the connection. `www` and the apex were also still pointing at `127.0.0.1` from before
# the zone moved, i.e. at each visitor's own machine.
#
# THE SAME CERTIFICATE AS EVERY OTHER VHOST, and that is deliberate. The Cloudflare
# Origin CA cert covers `calevate.tech` and would have worked here — but it exists for
# exactly one job (a certless `default_server` is Cloudflare 525) and using it for a
# second, unrelated one is two mechanisms for one problem. The Let's Encrypt lineage is
# expanded to six names instead: one certificate, one renewal, one hook.
#
# REALM ISOLATION APPLIES HERE TOO. This host proxies to the same Next.js process as the
# two consoles, so without the refusals below `calevate.tech/admin` would serve the
# operator sign-in page to anybody who guessed the path — the exact hole P7.3 closed
# between `admin.` and `app.`, reopened on a third hostname.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ROOT_DOMAIN};

    ssl_certificate     ${TLS_LIVE_DIR}/fullchain.pem;
    ssl_certificate_key ${TLS_LIVE_DIR}/privkey.pem;
    include /etc/nginx/snippets/calevate-tls.conf;
    include /etc/nginx/snippets/calevate-origin.conf;
    include /etc/nginx/snippets/calevate-headers.conf;

    # Timeouts at SERVER scope, because `calevate-proxy.conf` deliberately sets none —
    # an include is textual, so a timeout in that file would land at location scope in
    # every block below and shadow this.
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    # Smaller than the consoles': nothing is uploaded to the marketing site, and a public
    # unauthenticated hostname is the wrong place to accept 25 MB from a stranger.
    client_max_body_size 1m;

    # Neither realm exists on the public hostname.
    # THE REALM REFUSALS RENDER OUR 404, not nginx's.
    #
    # `return 404` below is the control and stays exactly as it is — what changes is what
    # a person sees. A bare `nginx` error page tells a client who mistyped a path that
    # something is broken at the infrastructure level, when the truth is that the page
    # does not exist on this hostname; the app already has a designed not-found screen
    # with a way back.
    #
    # No `=` in the `error_page` directive, so the response KEEPS its 404 status — with
    # `=` nginx would rewrite it to 200 and hand a crawler a "successful" page.
    # `proxy_intercept_errors` is off by default, so this catches only the 404s nginx
    # itself generates here, never one Next returns for a route it has already handled.
    error_page 404 /_calevate_not_found;

    # `internal`, and an EXACT-MATCH location rather than a named one. `proxy_pass` may
    # not carry a URI part inside a named location — nginx refuses the whole config with
    # "proxy_pass cannot have URI part in location given by regular expression, or inside
    # named location" — and the URI is the entire point here. `internal` is what stops the
    # path being reachable directly, so nothing publishes a `/_calevate_not_found` URL.
    #
    # WHY `/not-found` AND NOT SOME OTHER PATH, stated correctly because the first version
    # of this comment stated it wrongly. There is NO `/not-found` route: the App Router's
    # mechanism is `app/not-found.tsx`, which renders for ANY address the router does not
    # match, `/not-found` included (verified by building this repo's `apps/web` and asking
    # the running server: `/404`, `/not-found`, `/nope/deep` and `/admin/zzz` each returned
    # 404 with the designed screen, 26 Aug 2026). So the URI here is simply a stable,
    # self-describing address that is guaranteed to be unmatched — and any path would do.
    #
    # The upstream therefore answers this subrequest with a 404 of its own, which is fine
    # and was measured rather than assumed: nginx serves the handler's BODY and returns the
    # ORIGINAL 404 to the client, with no error-page recursion and no 500. Reproduced on
    # nginx 1.24.0 against a stub upstream returning 404 for the handler URI.
    location = /_calevate_not_found {
        internal;
        proxy_pass http://calevate_web/not-found;
        include /etc/nginx/snippets/calevate-proxy.conf;
    }

    location ^~ /admin { return 404; }
    location ^~ /c/    { return 404; }

    # BUILD ASSETS ARE NOT RATE-LIMITED, and this location exists because the limiter was
    # firing on them. Every path here is content-addressed by Next's build hash
    # (`/_next/static/chunks/9926-8fef8aebe910ff85.js`), immutable, and served with
    # `Cache-Control: immutable` — so it is cached by Cloudflare and by the browser, and a
    # cold load of one console screen is dozens of them at once. Counting that fan-out
    # against a per-second budget meant an honest first visit spent its whole allowance on
    # JavaScript and then 429'd the navigation that needed it.
    #
    # Leaving them unlimited is bounded by what they are: a fixed set of static files that
    # touch no database, that Cloudflare answers from its own cache for anyone who is not
    # the first visitor, and whose URLs an attacker cannot vary — a hash that does not
    # exist 404s from Next without work. The traffic worth limiting is on the api vhost.
    location ^~ /_next/static/ {
        proxy_pass http://calevate_web;
        include /etc/nginx/snippets/calevate-proxy.conf;
    }

    location / {
        # burst=120, up from 30: see `rate-zones.conf.template` — an RSC prefetch fires per
        # sidebar link, so a burst that fits one page load is the requirement, not a
        # generosity.
        limit_req zone=browser burst=120 nodelay;
        proxy_pass http://calevate_web;
        include /etc/nginx/snippets/calevate-proxy.conf;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# `www` REDIRECTS rather than serving, so the marketing site has ONE canonical address.
# Two hostnames serving identical HTML is a duplicate-content split for no benefit, and
# every link we mint names the apex. 301 rather than 302: this is permanent, and the
# permanent form is what search engines and browsers cache.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${ROOT_DOMAIN};

    ssl_certificate     ${TLS_LIVE_DIR}/fullchain.pem;
    ssl_certificate_key ${TLS_LIVE_DIR}/privkey.pem;
    include /etc/nginx/snippets/calevate-tls.conf;
    include /etc/nginx/snippets/calevate-origin.conf;
    include /etc/nginx/snippets/calevate-headers.conf;

    # Stated even though this block proxies nothing: a future `location` added here would
    # otherwise inherit nginx's 60s global defaults, and the guard requires every TLS
    # vhost to name its own.
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    return 301 https://${ROOT_DOMAIN}$request_uri;
}

# --- admin + app: the two browser realms, and they are now actually two -----------
#
# THIS WAS ONE SERVER BLOCK FOR BOTH HOSTNAMES (P7.3), which made a premise the frontend
# reasons from simply untrue: disjoint route trees on disjoint hostnames, so only one
# realm's session provider is ever mounted. With one block and one `location /`,
# `app.${ROOT_DOMAIN}/admin` served the operator console and
# `admin.${ROOT_DOMAIN}/c/<slug>` served a client dashboard.
#
# WHAT IT WAS AND WAS NOT. Not an authorization hole: the realm is inside the session
# token's hash domain (`authn/sessions.token_fingerprint`), so a client credential
# presented on the admin door matches no row whatever hostname carried it. What it WAS is
# the operator SIGN-IN surface — `/auth/admin/sign-in` — served on the hostname every
# client is told to visit, which is phishing surface for the one console that holds
# cross-client data. A 404 costs nothing and removes it.
#
# IT MATTERS MORE SINCE D-177, and AUTH-MIGRATION §3 called that in advance: both realms'
# `__Host-` cookies land on one API host, so the hostname split is what keeps the two
# consoles apart in a browser rather than merely tidy.
#
# `^~` RATHER THAN A PREFIX MATCH, and the marker is the load-bearing part: nginx tries
# regex locations before plain prefix ones, so a future `location ~ \.(js|css)$` added
# above would win over `location /admin` and re-open the hole. `^~` stops the search at the
# longest matching prefix and cannot be overtaken by a regex added later.
#
# 404 RATHER THAN 403, deliberately: 403 confirms that something is there. A stranger
# probing `app.${ROOT_DOMAIN}/admin` learns nothing they did not already know.
#
# The two blocks are otherwise IDENTICAL, and the duplication is the point rather than a
# smell — they proxy the same upstream and differ only in which realm each refuses. An
# include would make the difference the only thing NOT in the file a reviewer reads.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.${ROOT_DOMAIN};

    ssl_certificate     ${TLS_LIVE_DIR}/fullchain.pem;
    ssl_certificate_key ${TLS_LIVE_DIR}/privkey.pem;
    include /etc/nginx/snippets/calevate-tls.conf;
    include /etc/nginx/snippets/calevate-origin.conf;
    include /etc/nginx/snippets/calevate-headers.conf;

    # Timeouts at SERVER scope, because `calevate-proxy.conf` deliberately sets none —
    # an include is textual, so a timeout in that file would land at location scope in
    # every block below and shadow this. `tests/assist_deadline_test.py` reads the api
    # vhost's `proxy_read_timeout` as the budget the dashboard-assist path must fit
    # inside, so 60s here is a Python deadline as well as an nginx one.
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    # Next.js serves its own static assets; 25m covers a KB document upload from the
    # dashboard without letting the edge become an upload sink.
    client_max_body_size 25m;

    # The ADMIN realm does not exist on the client hostname. Covers `/admin/sign-in` —
    # the operator door — and every operator screen under it.
    # THE REALM'S FRONT DOOR, and without this it was the MARKETING PAGE.
    #
    # Next serves `apps/web/src/app/page.tsx` at `/`, and all three browser vhosts proxy
    # `/` to the same process — so `app.${ROOT_DOMAIN}/` rendered the public site, complete with a
    # "Create a workspace" button, on the hostname clients use. It was invisible while the apex had no vhost
    # of its own (marketing was only reachable here), and became wrong the moment the apex
    # started serving it properly.
    #
    # `= /` is an EXACT match: it claims the bare root and nothing else, so every real
    # route under this hostname is untouched. 302 rather than 301 because this is a
    # routing convenience and not a canonical address — a permanently-cached redirect on
    # a realm root is a decision that cannot be taken back without waiting out every
    # browser cache (`www` -> apex is 301, which IS canonical, and stays that way).
    location = / { return 302 /c; }

    # THE REALM REFUSALS RENDER OUR 404, not nginx's.
    #
    # `return 404` below is the control and stays exactly as it is — what changes is what
    # a person sees. A bare `nginx` error page tells a client who mistyped a path that
    # something is broken at the infrastructure level, when the truth is that the page
    # does not exist on this hostname; the app already has a designed not-found screen
    # with a way back.
    #
    # No `=` in the `error_page` directive, so the response KEEPS its 404 status — with
    # `=` nginx would rewrite it to 200 and hand a crawler a "successful" page.
    # `proxy_intercept_errors` is off by default, so this catches only the 404s nginx
    # itself generates here, never one Next returns for a route it has already handled.
    error_page 404 /_calevate_not_found;

    # `internal`, and an EXACT-MATCH location rather than a named one. `proxy_pass` may
    # not carry a URI part inside a named location — nginx refuses the whole config with
    # "proxy_pass cannot have URI part in location given by regular expression, or inside
    # named location" — and the URI is the entire point here. `internal` is what stops the
    # path being reachable directly, so nothing publishes a `/_calevate_not_found` URL.
    #
    # WHY `/not-found` AND NOT SOME OTHER PATH, stated correctly because the first version
    # of this comment stated it wrongly. There is NO `/not-found` route: the App Router's
    # mechanism is `app/not-found.tsx`, which renders for ANY address the router does not
    # match, `/not-found` included (verified by building this repo's `apps/web` and asking
    # the running server: `/404`, `/not-found`, `/nope/deep` and `/admin/zzz` each returned
    # 404 with the designed screen, 26 Aug 2026). So the URI here is simply a stable,
    # self-describing address that is guaranteed to be unmatched — and any path would do.
    #
