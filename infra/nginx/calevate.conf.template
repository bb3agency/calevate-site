# --- api: both realms' backend --------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.${ROOT_DOMAIN};

    ssl_certificate     ${TLS_LIVE_DIR}/fullchain.pem;
    ssl_certificate_key ${TLS_LIVE_DIR}/privkey.pem;
    include /etc/nginx/snippets/calevate-tls.conf;
    include /etc/nginx/snippets/calevate-origin.conf;
    include /etc/nginx/snippets/calevate-headers.conf;

    # Timeouts at SERVER scope, because `calevate-proxy.conf` deliberately sets none —
    # an include is textual, so a timeout in that file would land at location scope in
    # every block below and shadow this. `tests/assist_deadline_test.py` reads the api
    # vhost's `proxy_read_timeout` as the budget the dashboard-assist path must fit
    # inside, so 60s here is a Python deadline as well as an nginx one.
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    client_max_body_size 25m;

    # Ordered most-specific first. nginx picks the longest matching prefix, so the order
    # here is for the reader; the `=` and `^~` markers are what actually pin them.
    #
    # THESE STAY OPEN, AND THE RESTRICTION THAT BELONGS HERE IS NOT AN `allow`/`deny`
    # (D-128). `/healthz/ready` used to publish the NAMES of the credentials this
    # deployment had not installed. It is fixed in the app — the status word and the
    # status code answer everybody, the detail answers `ops:manage` — because the
    # alternative considered here does not work: `calevate-origin.conf` is included by
    # this server block already, and what it admits is every Cloudflare edge range, i.e.
    # the whole internet on a proxied zone. A tighter `allow` list here would refuse the
    # authorised operator alongside the stranger, since both arrive from the same edge.
    location = /healthz          { limit_req zone=health burst=5 nodelay; proxy_pass http://calevate_api; include /etc/nginx/snippets/calevate-proxy.conf; }
    location ^~ /healthz/        { limit_req zone=health burst=5 nodelay; proxy_pass http://calevate_api; include /etc/nginx/snippets/calevate-proxy.conf; }

    # Sessions and token exchange. The tightest zone in the set.
    location ^~ /v1/auth/ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://calevate_api;
        include /etc/nginx/snippets/calevate-proxy.conf;
    }

    location ^~ /v1/admin/ {
        limit_req zone=admin_api burst=40 nodelay;
        proxy_pass http://calevate_api;
        include /etc/nginx/snippets/calevate-proxy.conf;
    }

    location / {
        limit_req zone=client_api burst=30 nodelay;
        proxy_pass http://calevate_api;
        include /etc/nginx/snippets/calevate-proxy.conf;
    }
}

# --- hooks: voice-runtime's public face -----------------------------------------
# POLICY, restated here because it is the one server block whose rules are inverted
# (DEPLOYMENT §5.2): NEVER maintenance-gated, NEVER behind auth_request, NEVER challenged
# at the edge. An engine callback that meets a maintenance page or a bot challenge is a
# lost call, and Bolna sends no retry (D-31) — the reconciliation poller is the only
# recovery and it runs on a 10-minute tick.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name hooks.${ROOT_DOMAIN};

    ssl_certificate     ${TLS_LIVE_DIR}/fullchain.pem;
    ssl_certificate_key ${TLS_LIVE_DIR}/privkey.pem;
    include /etc/nginx/snippets/calevate-tls.conf;
    include /etc/nginx/snippets/calevate-origin.conf;
    include /etc/nginx/snippets/calevate-headers.conf;

    # Sized for a post-call payload carrying a full transcript. Larger than the browser
    # realms because the sender is a machine we cannot ask to paginate.
    client_max_body_size 10m;

    # Do not let a slow upstream turn into a queue of held connections on the box that
    # also has to ack in 500ms. The app abandons at its own 2s durable deadline and
    # answers 503; these bounds are the layer above that, not a replacement for it.
    #
    # THESE ARE THE EFFECTIVE VALUES for every location in this vhost, and the note that
    # stood here saying they "govern nothing today" described a config that nginx refuses
    # to load. `calevate-proxy.conf` set the browser realms' 5s/60s/60s and the catch-all
    # below restated 2s/15s/15s after including it — two `proxy_connect_timeout` at one
    # level, which is `[emerg] directive is duplicate`, not a last-one-wins. The snippet
    # no longer sets any timeout, so nothing shadows these and there is nothing to keep
    # in step.
    proxy_connect_timeout 2s;
    proxy_send_timeout    15s;
    proxy_read_timeout    15s;

    # NO HEALTH ROUTE ON THIS HOSTNAME, and a 404 rather than a deletion.
    #
    # This vhost used to proxy `= /healthz` and `^~ /healthz/` to voice-runtime. Nothing
    # needs them here: the deploy polls `127.0.0.1:8100/healthz` directly and compose's
    # healthcheck runs `/healthz/live` inside the container, so both readers are already
    # on the loopback side of nginx. What the pair DID buy was a public path to
    # `/healthz/ready`, whose handler resolves the engine adapter and drags `httpx` and
    # `apps.api.engine.bolna` onto the event loop that has 500ms to ack a webhook —
    # measured at 381-435ms of import on a first call, on the one service where that is a
    # lost call rather than a slow page.
    #
    # DELETING the two lines does NOT close it: `location /` below is a prefix match on
    # `/`, so every `/healthz*` request would simply fall through to it and reach the same
    # handler — with the webhook rate zone paying for it. Closing it takes a location that
    # answers instead of proxying, and `^~` so it wins over that catch-all.
    #
    # 404, not 403: the route genuinely does not exist on `hooks.`, and saying so tells a
    # scanner less than a refusal does. The app-side fix (a per-service config probe, so
    # readiness never constructs an adapter) is the other half and is not made redundant
    # by this — voice-runtime still serves the route on the loopback interface.
    location ^~ /healthz { return 404; }

    location / {
        # `burst=200 nodelay` on top of 600r/m: the average is a campaign's worth of
        # traffic, the burst is 250 calls hanging up in the same second (D-32). Without
        # the burst allowance the steady-state rate alone would reject the exact shape of
        # traffic this endpoint exists for.
        limit_req zone=webhooks burst=200 nodelay;
        proxy_pass http://calevate_hooks;
        include /etc/nginx/snippets/calevate-proxy.conf;

        # `auth_request` buffers the request body, which breaks large POSTs
        # (DEPLOYMENT §10). There is no auth_request here, and streaming the body to the
        # app rather than buffering it at the edge is also how the ack budget is measured
        # from the first byte the app sees.
        proxy_request_buffering off;
    }
}
