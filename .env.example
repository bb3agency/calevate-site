# Canonical list of environment variables (DEV-SETUP.md §4).
# Copy to .env and fill. NEVER commit .env — prod values live only in the
# secrets manager and are injected at deploy time.
# Any new variable added here must also be added to
# packages/shared/src/calevate_shared/config.py so startup fails fast.

# REQUIRED, and there is deliberately no default anywhere in the code: `local` is the
# only value under which the API accepts a `dev:<realm>:<clerk-id>` token — a credential
# whose subject the caller chooses — so a deployment that forgot this variable used to be
# unauthenticated AND report itself healthy on /healthz/ready. One of local|staging|prod;
# the process refuses to start on anything else, naming the variable and the allowed set.
APP_ENV=local

# Non-default host ports: 5432/6379 are occupied by another project on this
# machine. Container-internal ports are unchanged.
# DATABASE_URL = the APP role (calevate_app: NOSUPERUSER NOBYPASSRLS — RLS depends
# on this; the bootstrap superuser bypasses policies entirely).
# ALEMBIC_DATABASE_URL = the owner role, used ONLY by migrations.
DATABASE_URL=postgresql+psycopg://calevate_app:calevate_app@localhost:5433/calevate
ALEMBIC_DATABASE_URL=postgresql+psycopg://calevate:calevate@localhost:5433/calevate
REDIS_URL=redis://localhost:6380/0

# Persistent Postgres connections PER PROCESS (not per deployable — every uvicorn and
# ARQ worker builds its own pool, so the cluster total is this x every process and it
# has to fit under the server's max_connections). There is no overflow: connections
# above this number would be single-use, and re-authenticating them costs ~6ms of CPU
# each on the one core an asyncio process has (apps/api/db/session.py). Size it per
# deployable — DEPLOYMENT §2a has the arithmetic and the measured numbers.
DB_POOL_SIZE=16

OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=calevate-dev

# Public base URL of voice-runtime — baked into each agent's engine config at publish
# time, so it must be reachable BY THE ENGINE (prod: https://hooks.calevate.tech).
WEBHOOK_BASE_URL=http://localhost:8100

# fake | bolna — `fake` keeps all local work offline and deterministic.
# ThinnestAI was retired by D-31 before any adapter existed; do not re-add it.
ENGINE=fake
# Bolna webhooks are UNSIGNED (D-31) — there is deliberately no webhook secret.
# Authenticity = source-IP allowlist + execution-id dedupe (TRD §5).
BOLNA_API_KEY=
# The engine's egress addresses — comma-separated, literal IPs only. Not a secret: it
# is the whole authenticity control for an unsigned engine, and it is a value the
# VENDOR owns. Here rather than in code so rotating it is a restart, not a deploy of
# the latency-critical service. Junk entries are dropped and an empty value falls back
# to the documented default, because an empty allowlist would 401 the engine itself.
BOLNA_WEBHOOK_SOURCE_IPS=13.203.39.153
# Engine costs arrive in USD cents; this rate converts them at capture and is stamped
# into every usage_events row so the ledger stays reproducible (hard rule 7).
USD_INR_RATE=88.00

# BYOK models — canonical stack per D-36: Sarvam does STT + LLM + TTS.
# GEMINI is a configurable FALLBACK, not the default.
SARVAM_API_KEY=
GEMINI_API_KEY=
# Only needed if the D-28 RAG bake-off picks a store without bundled embeddings.
COHERE_API_KEY=

# Two SEPARATE Clerk applications — admin realm and client realm never share
# session logic (TRD §11).
CLERK_ADMIN_PUBLISHABLE_KEY=
CLERK_ADMIN_SECRET_KEY=
CLERK_CLIENT_PUBLISHABLE_KEY=
CLERK_CLIENT_SECRET_KEY=
# Custom Clerk domain (D-37) — also the JWKS host the API verifies tokens against.
CLERK_FRONTEND_API=accounts.calevate.tech
# Svix signing secret for the Clerk user/org mirror webhook (whsec_...).
# Unset = the endpoint refuses every event rather than trusting it.
CLERK_WEBHOOK_SECRET=

# --- The BROWSER's half lives in `apps/web/.env.example` ---------------------
# Not here, and this file must not grow a NEXT_PUBLIC_ line: it is checked both
# ways against `calevate_shared.config.Settings` (scripts/check_env_parity.py),
# and none of the browser's keys may BE Settings fields — they are inlined into
# the JS bundle by `next build`, and the API neither reads them nor should be
# able to (D-49 moved PostHog out of Settings for exactly this reason).
#
# They were listed here as COMMENTS for that reason, which made them a
# declaration no machine could check — including the one that decides whether the
# browser presents a real Clerk token or the local `dev:<realm>:<id>` credential.
# `apps/web/.env.example` is now the canonical list, `apps/web/.env.local` is
# what a developer copies it to (Next loads env from the PACKAGE directory, never
# from here), and `scripts/check_web_env_parity.py` checks it both ways against
# the reads in `apps/web`. Changing one needs a rebuild, not a restart.
#
# The two publishable keys there must NAME THE SAME Clerk applications as
# CLERK_CLIENT_PUBLISHABLE_KEY / CLERK_ADMIN_PUBLISHABLE_KEY above: the API
# derives each realm's JWKS host from its copy (`core/auth.py::jwks_url`), so a
# mismatch is a browser minting tokens no verifier will accept.

# HMAC material for the audit hash chain + idempotency scope fingerprints.
# Unset locally = a derived constant; prod MUST inject a real secret.
AUDIT_CHAIN_SECRET=

# Email transport for hot-lead alerts. Unset locally = console sink; unset in
# staging/prod = notifications report failure rather than pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFICATIONS_FROM=alerts@calevate.tech

# WHERE OPERATOR ALERTS GO (OPERATIONS §4; §8 pre-launch gate "alerts firing to Sri's
# phone"). Delivered through the transport above, so locally an alert lands in the
# console sink and needs nothing running. UNSET = alerts are logged and reach NOBODY;
# the process says so at boot (`alert_delivery_unconfigured`). Set this before go-live.
ALERTS_EMAIL=

# THE EXTERNAL DEAD MAN'S SWITCH (D-50). Ping URL of one hosted dead-man check
# (Healthchecks.io: https://hc-ping.com/<uuid>). `scripts/backup/backup-health.sh`
# pings it ONLY when every backup check passed, so a failed check, a dead host or a
# stopped systemd all page by SILENCE — the one class of failure no check running on
# the database host can report about itself. There is deliberately no failure ping.
#
# THIS IS A CREDENTIAL. Anyone who has it can silence the alarm by pinging it. Inject
# it from the secrets manager (prod: on the DATABASE host, via the repo `.env` or
# /etc/calevate/alerts.env — infra/backup/README.md §5). Never commit a real value.
#
# EMPTY HERE ON PURPOSE: locally and in CI the heartbeat is a no-op that says so once
# instead of pretending to be wired. Set it before go-live, and configure the check's
# period/grace on the vendor side (15 minutes / 1 hour) or the URL alerts on nothing.
BACKUP_HEARTBEAT_URL=

# WhatsApp transport for hot-lead alerts (ROADMAP M2). Leave OFF until the checklist
# in apps/workers/whatsapp.py is done (WABA + business verification, approved template,
# recorded per-tenant opt-in). No BSP is chosen in the decision log yet: `console` is
# the local dev sink and is refused outside APP_ENV=local; any other value refuses to
# send with `provider_not_implemented` rather than pretending to be configured.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=
WHATSAPP_TEMPLATE_HOT_LEAD=calevate_hot_lead_v1
WHATSAPP_TEMPLATE_LOCALE=en

# Google Sheets delivery for outbound CRM sync (D-23). Same seam as WHATSAPP_PROVIDER:
# `console` is the local dev sink and is refused outside APP_ENV=local; `service_account`
# selects the real adapter (apps/workers/google_sheets.py); any other value refuses to
# append with `provider_not_implemented` rather than pretending to be configured. Unset
# falls back to the dev sink locally and a refusal everywhere else. This is ALSO the gate
# the API uses: with no working provider, creating a Google Sheets endpoint is refused
# outright rather than offered as a checkbox nothing delivers.
GOOGLE_SHEETS_PROVIDER=

# The service-account key JSON, for GOOGLE_SHEETS_PROVIDER=service_account. Injected from
# the secrets manager at deploy time like every other vendor key — NEVER committed, and
# never in the database: the endpoint row holds only the reference
# `sm://google-sheets/default`, which names this credential rather than containing it.
#
# The client grants access by sharing THEIR spreadsheet with this service account's
# client_email (Editor), and revokes it by un-sharing. That is why one key serves every
# tenant: it can only ever reach documents someone chose to share with it.
#
# Setting GOOGLE_SHEETS_PROVIDER=service_account without this is a refusal, not a
# half-configured transport — the API stops offering Sheets endpoints entirely.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# No LANGFUSE_* or POSTHOG_KEY here, deliberately: nothing in the tree reads them, so
# filling them in would have recorded nothing while looking configured. What restoring
# each one actually takes is written down in packages/shared/src/calevate_shared/config.py
# next to SENTRY_DSN.
SENTRY_DSN=
# Stamped on every error report; CI sets this from the commit sha.
RELEASE_VERSION=dev

# OpenTelemetry (TRD §2) — base URL of an OTLP/HTTP collector; the exporter appends
# /v1/traces. LEAVE EMPTY LOCALLY: empty means no tracing at all (no SDK import, no
# exporter thread), so tests and a dev box need no collector running. Point it at a
# local Jaeger (http://localhost:4318) only when you actually want to look at spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Head sampling for ROOT traces; every hop of a sampled call is kept, so a trace is
# whole from webhook to Postgres. 1.0 here is the LOCAL value — the code default is
# 0.1, which is what prod gets when this is not injected. Raise prod to 1.0 during an
# incident (env change + restart), then put it back.
OTEL_TRACES_SAMPLE_RATIO=1.0

# Dispatcher: share of the engine line pool reserved for inbound (FLOWS §5).
INBOUND_RESERVE_RATIO=0.3
# Self-serve list price per calling minute, INR (D-34). Runway framing and the
# top-up flow both price from this one number.
SELF_SERVE_INR_PER_MIN=6.00
# Public self-serve signup (D-34 motion 2). OFF by default — R-11 makes this the
# sharp compliance edge, so opening the intake is a deliberate act and closing it
# during an incident is an env change, not a deploy.
SELF_SERVE_SIGNUP_ENABLED=false

# Razorpay prepaid top-ups (D-34). NO ACCOUNT IS PROVISIONED and the vendor contract
# is UNVERIFIED — apps/api/billing/payments.py isolates every assumption about their
# signing scheme and payload shape; verify those before setting these.
# WHICH provider this deployment has. `razorpay` is the only name with anything behind
# it; any other value refuses every payment surface with `provider_not_implemented`
# rather than looking configured. Unset = this deployment takes no online payments, and
# the top-up route says so in problem+json instead of minting an intent no checkout can
# open. This is a STATEMENT ABOUT THE CAPABILITY, not a credential — the key id and the
# webhook secret below are separate and are still both required.
PAYMENT_PROVIDER=
# The PUBLIC key id the browser's checkout uses. Unset = the top-up intent refuses
# rather than handing back an intent no checkout can open.
RAZORPAY_KEY_ID=
# Webhook signing secret from their dashboard. Unset = the payment receiver refuses
# every event (fail closed): an unverifiable payment feed credits wallets on anyone's
# say-so.
RAZORPAY_WEBHOOK_SECRET=

# Telephony vendor for BUYING numbers (D-05: Exotel, with Vobiz for the 140-series).
# NO ACCOUNT IS PROVISIONED, no credentials exist and NO PROVISIONING ADAPTER IS
# WRITTEN — apps/api/campaigns/provisioning.py owns the one selector and states this in
# `PROVISIONING_IMPLEMENTED = False`. So this value currently decides only which refusal
# an operator sees: unset = `no_number_provider`, a name outside {exotel, vobiz} =
# `provider_not_implemented`, a known name = `no_provisioning_adapter`. Numbers are
# provisioned by Calevate operations out of band today. This is a STATEMENT ABOUT THE
# CAPABILITY, never a credential.
NUMBER_PROVIDER=
