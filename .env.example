# THE BOOTSTRAP SET — eight variables, and deliberately nothing else.
#
# Copy to .env and fill. NEVER commit .env — prod values live only in the secrets
# manager and are injected at deploy time.
#
# WHERE THE OTHER FIFTY KEYS WENT: to the ops console, `admin.calevate.tech/ops`
# (PLATFORM-CONFIG §4/§7, D-95). All 50 of them — 33 core-config values and 17
# credentials — are now set from a screen, no SSH session, no restart. Nothing was
# deleted: `scripts/check_env_parity.py` fails CI if a `Settings` field is declared in
# NEITHER this file NOR the console, so a key that vanished by mistake is a red build,
# not a silent gap. To see the full list with its current values and sources, open the
# console, or run:
#
#   uv run python -c "from apps.api.core.platform_config import managed_fields; \
#     from apps.api.ops.secret_service import manageable_secret_keys; \
#     print(sorted(set(managed_fields()) | set(manageable_secret_keys())))"
#
# WHY THESE EIGHT CANNOT FOLLOW. Resolution order is
# `os.environ` → `platform_settings`/`platform_secrets` → code default → refuse. Reading
# a key from the store therefore requires a process that has already reached the store,
# and these eight are what getting there costs. The console cannot configure the thing
# the console needs in order to start. The first six are §4's bootstrap set and
# `scripts/check_bootstrap_keys.py` enforces that they stay env-only; the last two are
# here for a mechanical reason given at their own entry.
#
# Adding a NINTH key here is almost always the wrong move: a new variable belongs in
# `packages/shared/src/calevate_shared/config.py` and is then console-managed by
# default. It only belongs in this file if a process cannot reach the store without it.
#
# The BROWSER's variables are a separate file, `apps/web/.env.example`, and must never
# appear here: Next inlines every `NEXT_PUBLIC_*` at build time, and none of them may be
# a `Settings` field (D-49). `scripts/check_web_env_parity.py` checks that half.

# ENV-ONLY because it decides the SECURITY POSTURE, and a value read from the database
# means the database decides it (D-49). `local` is the only value under which the API
# accepts a `dev:<realm>:<clerk-id>` token — a credential whose subject the caller
# chooses — so a deployment that resolved this from a store an attacker could write
# would be handing out authentication. No default anywhere in the code: one of
# local|staging|prod, and the process refuses to start on anything else, naming the
# variable and the allowed set.
APP_ENV=local

# ENV-ONLY because these ARE how you reach the store. A DSN kept in the database is a
# lock whose key is inside the box.
#
# Non-default host ports: 5432/6379 are occupied by another project on this machine.
# Container-internal ports are unchanged.
# DATABASE_URL = the APP role (calevate_app: NOSUPERUSER NOBYPASSRLS — RLS depends on
# this; the bootstrap superuser bypasses policies entirely).
# ALEMBIC_DATABASE_URL = the owner role, used ONLY by migrations — which run BEFORE the
# store is guaranteed to exist, so it cannot be read from a table it may be creating.
DATABASE_URL=postgresql+psycopg://calevate_app:calevate_app@localhost:5433/calevate
ALEMBIC_DATABASE_URL=postgresql+psycopg://calevate:calevate@localhost:5433/calevate

# ENV-ONLY because the workers need it before settings resolve, and because the config
# sentinel itself lives here: the cheap poll that tells every process the console
# changed something is a Redis GET, so Redis cannot be a thing the console configures.
REDIS_URL=redis://localhost:6380/0

# ENV-ONLY because it is THE KEY THAT OPENS THE CREDENTIAL STORE (PLATFORM-CONFIG §3/§4):
# every console-managed secret above is ciphertext until this unwraps it. Base64 of
# exactly 32 random bytes:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# It wraps a per-secret DEK; the secrets themselves live encrypted in Postgres and this
# value NEVER does — a database holding both the lock and the key is theatre. Unset
# locally = a public derived constant; anywhere else, absent OR the wrong length is one
# refusal.
PLATFORM_KEK=
# The PREVIOUS PLATFORM_KEK, if this deployment has ever rotated it. Unwraps only, never
# wraps — same shape as AUDIT_CHAIN_SECRET_RETIRED (D-86). Env-only for the same reason
# as the key it replaces. Leave empty until you rotate: set it to the outgoing value in
# the SAME deploy that installs the new one, and every DEK written under it still opens
# while the rewrap runs.
PLATFORM_KEK_RETIRED=

# ENV-ONLY FOR A DIFFERENT AND PURELY MECHANICAL REASON, and the honest floor is 8
# rather than §4's 6 because of it. Both are REQUIRED `Settings` fields with no default,
# and `Settings()` must construct before any code can read the store — so a process
# whose environment lacks them cannot boot far enough to find them in the database, even
# though `admin.calevate.tech/ops` does manage them (they show as source `env`,
# read-only, whenever they are set here). Verified by experiment, not by reading:
# `tests/env_example_bootstrap_floor_test.py` boots `Settings` off exactly this file's
# key set and off every 7-key subset of it, and is what will notice if a future change
# gives either one a default or makes a ninth key required.
#
# NOTE for whoever owns the boot gate: their absence today produces a Pydantic
# ValidationError traceback rather than the named refusal `validate_bootstrap_env`
# gives for APP_ENV/DATABASE_URL/REDIS_URL. Adding them to `BOOTSTRAP_REQUIRED`
# (apps/api/core/settings.py) would fix that; it is outside this file's ownership.
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=calevate-dev
