# Canonical list of environment variables (DEV-SETUP.md §4).
# Copy to .env and fill. NEVER commit .env — prod values live only in the
# secrets manager and are injected at deploy time.
# Any new variable added here must also be added to
# packages/shared/src/calevate_shared/config.py so startup fails fast.

APP_ENV=local

# Non-default host ports: 5432/6379 are occupied by another project on this
# machine. Container-internal ports are unchanged.
# DATABASE_URL = the APP role (calevate_app: NOSUPERUSER NOBYPASSRLS — RLS depends
# on this; the bootstrap superuser bypasses policies entirely).
# ALEMBIC_DATABASE_URL = the owner role, used ONLY by migrations.
DATABASE_URL=postgresql+psycopg://calevate_app:calevate_app@localhost:5433/calevate
ALEMBIC_DATABASE_URL=postgresql+psycopg://calevate:calevate@localhost:5433/calevate
REDIS_URL=redis://localhost:6380/0

OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=calevate-dev

# fake | bolna — `fake` keeps all local work offline and deterministic.
# ThinnestAI was retired by D-31 before any adapter existed; do not re-add it.
ENGINE=fake
# Bolna webhooks are UNSIGNED (D-31) — there is deliberately no webhook secret.
# Authenticity = source-IP allowlist + execution-id dedupe (TRD §5).
BOLNA_API_KEY=
# Engine costs arrive in USD cents; this rate converts them at capture and is stamped
# into every usage_events row so the ledger stays reproducible (hard rule 7).
USD_INR_RATE=88.00

# BYOK models — canonical stack per D-36: Sarvam does STT + LLM + TTS.
# GEMINI is a configurable FALLBACK, not the default.
SARVAM_API_KEY=
GEMINI_API_KEY=
# Only needed if the D-28 RAG bake-off picks a store without bundled embeddings.
COHERE_API_KEY=

# Two SEPARATE Clerk applications — admin realm and client realm never share
# session logic (TRD §11).
CLERK_ADMIN_PUBLISHABLE_KEY=
CLERK_ADMIN_SECRET_KEY=
CLERK_CLIENT_PUBLISHABLE_KEY=
CLERK_CLIENT_SECRET_KEY=
# Custom Clerk domain (D-37) — also the JWKS host the API verifies tokens against.
CLERK_FRONTEND_API=accounts.calevate.tech

# HMAC material for the audit hash chain + idempotency scope fingerprints.
# Unset locally = a derived constant; prod MUST inject a real secret.
AUDIT_CHAIN_SECRET=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
POSTHOG_KEY=

# Dispatcher: share of the engine line pool reserved for inbound (FLOWS §5).
INBOUND_RESERVE_RATIO=0.3
