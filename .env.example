# Canonical list of environment variables (DEV-SETUP.md §4).
# Copy to .env and fill. NEVER commit .env — prod values live only in the
# secrets manager and are injected at deploy time.
# Any new variable added here must also be added to
# packages/shared/src/calevate_shared/config.py so startup fails fast.

APP_ENV=local

# Non-default host ports: 5432/6379 are occupied by another project on this
# machine. Container-internal ports are unchanged.
# DATABASE_URL = the APP role (calevate_app: NOSUPERUSER NOBYPASSRLS — RLS depends
# on this; the bootstrap superuser bypasses policies entirely).
# ALEMBIC_DATABASE_URL = the owner role, used ONLY by migrations.
DATABASE_URL=postgresql+psycopg://calevate_app:calevate_app@localhost:5433/calevate
ALEMBIC_DATABASE_URL=postgresql+psycopg://calevate:calevate@localhost:5433/calevate
REDIS_URL=redis://localhost:6380/0

OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=calevate-dev

# Public base URL of voice-runtime — baked into each agent's engine config at publish
# time, so it must be reachable BY THE ENGINE (prod: https://hooks.calevate.tech).
WEBHOOK_BASE_URL=http://localhost:8100

# fake | bolna — `fake` keeps all local work offline and deterministic.
# ThinnestAI was retired by D-31 before any adapter existed; do not re-add it.
ENGINE=fake
# Bolna webhooks are UNSIGNED (D-31) — there is deliberately no webhook secret.
# Authenticity = source-IP allowlist + execution-id dedupe (TRD §5).
BOLNA_API_KEY=
# The engine's egress addresses — comma-separated, literal IPs only. Not a secret: it
# is the whole authenticity control for an unsigned engine, and it is a value the
# VENDOR owns. Here rather than in code so rotating it is a restart, not a deploy of
# the latency-critical service. Junk entries are dropped and an empty value falls back
# to the documented default, because an empty allowlist would 401 the engine itself.
BOLNA_WEBHOOK_SOURCE_IPS=13.203.39.153
# Engine costs arrive in USD cents; this rate converts them at capture and is stamped
# into every usage_events row so the ledger stays reproducible (hard rule 7).
USD_INR_RATE=88.00

# BYOK models — canonical stack per D-36: Sarvam does STT + LLM + TTS.
# GEMINI is a configurable FALLBACK, not the default.
SARVAM_API_KEY=
GEMINI_API_KEY=
# Only needed if the D-28 RAG bake-off picks a store without bundled embeddings.
COHERE_API_KEY=

# Two SEPARATE Clerk applications — admin realm and client realm never share
# session logic (TRD §11).
CLERK_ADMIN_PUBLISHABLE_KEY=
CLERK_ADMIN_SECRET_KEY=
CLERK_CLIENT_PUBLISHABLE_KEY=
CLERK_CLIENT_SECRET_KEY=
# Custom Clerk domain (D-37) — also the JWKS host the API verifies tokens against.
CLERK_FRONTEND_API=accounts.calevate.tech
# Svix signing secret for the Clerk user/org mirror webhook (whsec_...).
# Unset = the endpoint refuses every event rather than trusting it.
CLERK_WEBHOOK_SECRET=

# HMAC material for the audit hash chain + idempotency scope fingerprints.
# Unset locally = a derived constant; prod MUST inject a real secret.
AUDIT_CHAIN_SECRET=

# Email transport for hot-lead alerts. Unset locally = console sink; unset in
# staging/prod = notifications report failure rather than pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFICATIONS_FROM=alerts@calevate.tech

# WhatsApp transport for hot-lead alerts (ROADMAP M2). Leave OFF until the checklist
# in apps/workers/whatsapp.py is done (WABA + business verification, approved template,
# recorded per-tenant opt-in). No BSP is chosen in the decision log yet: `console` is
# the local dev sink and is refused outside APP_ENV=local; any other value refuses to
# send with `provider_not_implemented` rather than pretending to be configured.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=
WHATSAPP_TEMPLATE_HOT_LEAD=calevate_hot_lead_v1
WHATSAPP_TEMPLATE_LOCALE=en

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
# Stamped on every error report; CI sets this from the commit sha.
RELEASE_VERSION=dev
POSTHOG_KEY=

# OpenTelemetry (TRD §2) — base URL of an OTLP/HTTP collector; the exporter appends
# /v1/traces. LEAVE EMPTY LOCALLY: empty means no tracing at all (no SDK import, no
# exporter thread), so tests and a dev box need no collector running. Point it at a
# local Jaeger (http://localhost:4318) only when you actually want to look at spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Head sampling for ROOT traces; every hop of a sampled call is kept, so a trace is
# whole from webhook to Postgres. 1.0 here is the LOCAL value — the code default is
# 0.1, which is what prod gets when this is not injected. Raise prod to 1.0 during an
# incident (env change + restart), then put it back.
OTEL_TRACES_SAMPLE_RATIO=1.0

# Dispatcher: share of the engine line pool reserved for inbound (FLOWS §5).
INBOUND_RESERVE_RATIO=0.3
# Self-serve list price per calling minute, INR (D-34). Runway framing and the
# top-up flow both price from this one number.
SELF_SERVE_INR_PER_MIN=6.00
