# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.uv-python/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.turbo/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Local artefacts
*.log
*.err
.DS_Store
Thumbs.db
/tmp/
coverage/
.coverage
# What the suite that produced `.coverage` did (scripts/check_coverage_ratchet.py). An
# artefact of ONE run on ONE machine, like the data file it sits beside: committing it
# would hand the gate a manifest describing somebody else's run.
.coverage-run.json
htmlcov/

# Engine verification / eval outputs are committed deliberately, not by accident
!docs/**

# Local Redis snapshot — a runtime artifact of the dev redis-server, never source.
dump.rdb

# What `scripts/vps-deploy.sh` remembers about a HOST: the SHA last deployed there and
# the deploy history. Per-host state, not source — committing it would make one machine's
# history the whole fleet's, and the script's change detection would then diff against
# whatever the last committer's box happened to be running.
.deploy-state/

