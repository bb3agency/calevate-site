# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the declaration of what the browser's variables ARE, which is a checked
# artefact: `scripts/check_web_env_parity.py` reads it, and a template nobody can see
# is not a template. The repo root's .gitignore makes the same exception; this one has
# to repeat it because the deeper file wins.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
