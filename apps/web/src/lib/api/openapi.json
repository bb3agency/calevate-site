  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {}
            },
            "description": "RFC-9457 problem+json"
          }
        },
        "summary": "Health \u2014 DB + Redis",
        "tags": [
          "health"
        ]
      }
    },
    "/healthz/live": {
      "get": {
        "operationId": "live_healthz_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Healthz Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {}
            },
            "description": "RFC-9457 problem+json"
          }
        },
        "summary": "Liveness \u2014 touches no dependency",
        "tags": [
          "health"
        ]
      }
    },
    "/healthz/ready": {
      "get": {
        "operationId": "ready_healthz_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ready Healthz Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {}
            },
            "description": "RFC-9457 problem+json"
          }
        },
        "summary": "Readiness \u2014 the go-live gate",
        "tags": [
          "health"
        ]
      }
    },
